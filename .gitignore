*.py[cod]
*.egg-info/
build/
dist/
.venv/

# runtime artefacts
.planloop/runs/
.planloop/events/
# memory: public.db is shareable and committed, private.db never leaves the machine
.planloop/memory/private.db
.planloop/memory/*.db-journal
.planloop/memory/*.db-wal
.planloop/memory/*.db-shm
demo-run/
.demo/
.membench/
.membench-*/
.membench-*_events_summary.json
.dbg/
*.log

# local credentials (never commit)
.planloop/credentials.env
.planloop/*.env
